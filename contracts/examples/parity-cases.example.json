{
  "startupDelaySeconds": 3,
  "settleMilliseconds": 300,
  "sequences": {
    "common": [
      { "type": "capture", "name": "common" },
      { "type": "selectTab", "name": "Skills" },
      { "type": "waitFor", "label": "Active Skills" },
      { "type": "capture", "name": "skills" }
    ],
    "optional-magic": [
      { "type": "selectTab", "name": "Adept Powers", "optional": true },
      { "type": "waitFor", "label": "Power Points:" },
      { "type": "wait", "milliseconds": 100 },
      { "type": "capture", "name": "adept-powers" }
    ]
  },
  "buildActions": [
    { "type": "include", "name": "common" },
    { "type": "include", "name": "optional-magic" }
  ],
  "careerActions": [
    { "type": "include", "name": "common" }
  ],
  "characters": [
    { "path": "../fixtures/characters/example-build.chum", "mode": "build" },
    { "path": "../fixtures/characters/example-career.chum", "mode": "career" },
    {
      "path": "../fixtures/characters/example-career.chum",
      "mode": "career",
      "scenario": "calendar",
      "actions": [
        { "type": "selectTab", "name": "Calendar" },
        { "type": "waitFor", "label": "Add Week" },
        { "type": "capture", "name": "calendar" }
      ]
    },
    {
      "path": "../fixtures/characters/example-build.chum",
      "mode": "build",
      "scenario": "edit-and-reload",
      "actions": [
        { "type": "selectTab", "name": "Character Info" },
        { "type": "capture", "name": "character-info" },
        { "type": "setValue", "control": "txtCharacterName", "value": "Example" },
        { "type": "selectTab", "name": "Street Gear" },
        { "type": "selectTab", "name": "Gear" },
        { "type": "selectItem", "control": "treGear", "item": "Commlink" },
        { "type": "contextMenu", "control": "treGear", "item": "Add as Plugin" },
        { "type": "capture", "name": "gear-dialog" },
        { "type": "click", "control": "cmdCancel" },
        { "type": "saveReload" },
        { "type": "capture", "name": "reloaded" }
      ]
    }
  ]
}
