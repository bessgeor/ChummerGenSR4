{
  "name": "chummergensr4",
  "private": true,
  "description": "Character generator for Shadowrun 4th Edition",
  "type": "module",
  "workspaces": [
    "workflow"
  ],
  "scripts": {
    "start": "node --import tsx workflow/src/main.ts",
    "eval": "node --import tsx workflow/src/evals/eval-main.ts",
    "parity": "dotnet run --project parity/src/Parity.Capture -c Release --",
    "compare": "dotnet run --project parity/src/Parity.Compare -c Release --",
    "build:candidate": "node parity/scripts/build-candidate.mjs",
    "parity:test": "dotnet test parity/Parity.slnx",
    "openspec:validate": "openspec validate --all --strict",
    "contracts:generate": "node contracts/scripts/generate.mjs",
    "contracts:check": "node contracts/scripts/generate.mjs --check",
    "contracts:test": "tsc -p contracts && node --import tsx --test \"contracts/tests/*.test.ts\"",
    "workflow:typecheck": "tsc -p workflow",
    "workflow:test": "node --import tsx --test \"workflow/tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2",
    "@types/node": "22.20.4",
    "quicktype": "26.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
