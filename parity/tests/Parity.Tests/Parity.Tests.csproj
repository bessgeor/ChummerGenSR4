<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Parity.Tests</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The app's sources, compiled below, are written without nullable annotations. -->
    <NoWarn>$(NoWarn);CS8603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- The native Tesseract libraries and the language data are copied only by direct references. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Data.English" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Parity.Cases\Parity.Cases.csproj" />
    <ProjectReference Include="..\..\src\Parity.Capture\Parity.Capture.csproj" />
    <ProjectReference Include="..\..\src\Parity.Compare\Parity.Compare.csproj" />
    <!-- The core library targets .NET Framework and uses only types that .NET also provides. -->
    <ProjectReference Include="..\..\..\Core\Core.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adapters of the app that use only Windows Forms and drawing types and the core library's types, compiled into the tests. -->
    <Compile Include="..\..\..\Chummer\TreeNodeView.cs" Link="App\TreeNodeView.cs" />
    <Compile Include="..\..\..\Chummer\ContactColour.cs" Link="App\ContactColour.cs" />
    <Compile Include="..\..\..\Chummer\WeaponNodeFunction.cs" Link="App\WeaponNodeFunction.cs" />
    <Compile Include="..\..\..\Chummer\GrantedWeaponLists.cs" Link="App\GrantedWeaponLists.cs" />
    <Compile Include="..\..\..\Chummer\ContextMenuNodes.cs" Link="App\ContextMenuNodes.cs" />
    <Compile Include="..\..\..\Chummer\AppArguments.cs" Link="App\AppArguments.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
